msgid_plural "{0} games in {1}"
msgstr[0] "{0} joc în {1}"
msgstr[1] "{0} jocuri în {1}"
msgstr[2] "{0} de jocuri în {1}"

msgid "None in {0} yet"
msgstr "Încă niciunul în {0}"

msgid "{0} cannot be read"
msgstr "{0} nu poate fi citit"

msgid "Where your 3DS games go"
msgstr "Unde merg jocurile tale 3DS"

msgid "Where your Wii U games go"
