msgid "Playable"
msgstr "Oynanabilir"

msgctxt "status"
msgid "Issues"
msgstr "Sorunlu"

msgctxt "status"
msgid "Crashes"
msgstr "Çöküyor"

msgctxt "status"
msgid "Won't start"
msgstr "Başlamıyor"

msgid "the PS5 Vulkan driver did not start"
msgstr "PS5’in Vulkan sürücüsü başlamadı"

msgid "PS5CEMU-HAR cannot write to {0}. Is the HEN loaded?"
msgstr "PS5CEMU-HAR şuraya yazamıyor: {0}. HEN yüklü mü?"

msgid "PS5CEMU-HAR cannot create the MLC folder {0}"
msgstr "PS5CEMU-HAR MLC klasörünü oluşturamıyor: {0}"

msgid "The game's base files were not found."
msgstr "Oyunun temel dosyaları bulunamadı."

msgid "The game could not be mounted. Check that its files are still in the game files folder."
msgstr "Oyun bağlanamadı. Dosyalarının hâlâ oyun klasöründe olup olmadığını kontrol edin."

msgid "The game could not be started."
msgstr "Oyun başlatılamadı."

msgid "This is not a Wii U game PS5CEMU-HAR can start."
msgstr "Bu, PS5CEMU-HAR’ın başlatabileceği bir Wii U oyunu değil."

msgid "Its disc key is missing from /data/ps5cemu/keys.txt."
msgstr "Disk anahtarı /data/ps5cemu/keys.txt dosyasında yok."

msgid "Its title.tik is missing."
msgstr "title.tik dosyası eksik."

msgid "The executable could not be started."
msgstr "Çalıştırılabilir dosya başlatılamadı."

msgid "The Vulkan renderer did not start: {0}"
msgstr "Vulkan oluşturucusu başlamadı: {0}"

msgid "Touchpad click + Options: the in-game menu (screens, picture, volume, controls, the library)"
msgstr "Dokunmatik yüzey tıklaması + OPTIONS: oyun içi menü (ekranlar, görüntü, ses, kontroller, kütüphane)"

