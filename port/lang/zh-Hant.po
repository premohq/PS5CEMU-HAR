msgstr "僅適用於{0}。其他設定沿用其模式的設定。"

#: port/frontend/shell/settings.cpp:222
msgid "{0}'s saves only. Settings has every side's."
msgstr "只有{0}的存檔。所有模式的存檔在「設定」中。"

