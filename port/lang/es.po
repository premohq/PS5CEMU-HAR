#: port/frontend/shell/setup.cpp:177
msgid "/data is reachable"
msgstr "/data es accesible"

#: port/frontend/shell/setup.cpp:178
msgid "Where everything is kept"
msgstr "Dónde se guarda todo"

#: port/frontend/shell/setup.cpp:179
msgid "Settings, saves, caches and logs live in {0}, which your HEN opens to PS5CEMU-HAR: its app jailbreak, or elfldr with the helper that comes with the app."
msgstr "Los ajustes, partidas guardadas, cachés y registros están en {0}, que tu HEN abre a PS5CEMU-HAR: con su jailbreak de aplicaciones, o elfldr con el asistente que acompaña a la aplicación."

#: port/frontend/shell/setup.cpp:186
msgid "/data is out of reach: nothing can be kept"
msgstr "/data no es accesible: no se puede guardar nada"

#: port/frontend/shell/setup.cpp:187
msgid "Let PS5CEMU-HAR out of its sandbox"
msgstr "Saca a PS5CEMU-HAR de su entorno aislado"

