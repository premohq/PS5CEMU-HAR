msgid "Crashes"
msgstr "Crash"

msgctxt "status"
msgid "Won't start"
msgstr "Tidak mau mulai"

msgid "the PS5 Vulkan driver did not start"
msgstr "driver Vulkan PS5 tidak berjalan"

msgid "PS5CEMU-HAR cannot write to {0}. Is the HEN loaded?"
msgstr "PS5CEMU-HAR tidak bisa menulis ke {0}. Apakah HEN sudah dimuat?"

msgid "PS5CEMU-HAR cannot create the MLC folder {0}"
msgstr "PS5CEMU-HAR tidak bisa membuat folder MLC {0}"

msgid "The game's base files were not found."
msgstr "File dasar game tidak ditemukan."

msgid "The game could not be mounted. Check that its files are still in the game files folder."
msgstr "Game tidak bisa dipasang. Pastikan file-filenya masih ada di folder game."

msgid "The game could not be started."
msgstr "Game tidak bisa dimulai."

msgid "This is not a Wii U game PS5CEMU-HAR can start."
msgstr "Ini bukan game Wii U yang bisa dimulai oleh PS5CEMU-HAR."

msgid "Its disc key is missing from /data/ps5cemu/keys.txt."
msgstr "Kunci disknya tidak ada di /data/ps5cemu/keys.txt."

msgid "Its title.tik is missing."
msgstr "File title.tik-nya tidak ada."

msgid "The executable could not be started."
msgstr "File yang dapat dijalankan tidak bisa dimulai."

msgid "The Vulkan renderer did not start: {0}"
msgstr "Perender Vulkan tidak berjalan: {0}"

msgid "Touchpad click + Options: the in-game menu (screens, picture, volume, controls, the library)"
msgstr "Klik panel sentuh + OPTIONS: menu dalam game (layar, gambar, volume, kontrol, pustaka)"

