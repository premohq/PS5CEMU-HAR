msgid "Playable"
msgstr "Speelbaar"

msgctxt "status"
msgid "Issues"
msgstr "Problemen"

msgctxt "status"
msgid "Crashes"
msgstr "Crasht"

msgctxt "status"
msgid "Won't start"
msgstr "Start niet"

msgid "the PS5 Vulkan driver did not start"
msgstr "het Vulkan-stuurprogramma van de PS5 is niet gestart"

msgid "PS5CEMU-HAR cannot write to {0}. Is the HEN loaded?"
msgstr "PS5CEMU-HAR kan niet schrijven naar {0}. Is de HEN geladen?"

msgid "PS5CEMU-HAR cannot create the MLC folder {0}"
msgstr "PS5CEMU-HAR kan de MLC-map {0} niet maken"

msgid "The game's base files were not found."
msgstr "De basisbestanden van de game zijn niet gevonden."

msgid "The game could not be mounted. Check that its files are still in the game files folder."
msgstr "De game kon niet worden gekoppeld. Controleer of de bestanden nog in de gamemap staan."

msgid "The game could not be started."
msgstr "De game kon niet worden gestart."

msgid "This is not a Wii U game PS5CEMU-HAR can start."
msgstr "Dit is geen Wii U-game die PS5CEMU-HAR kan starten."

msgid "Its disc key is missing from /data/ps5cemu/keys.txt."
msgstr "De schijfsleutel ontbreekt in /data/ps5cemu/keys.txt."

msgid "Its title.tik is missing."
msgstr "De title.tik ontbreekt."

msgid "The executable could not be started."
msgstr "Het uitvoerbare bestand kon niet worden gestart."

msgid "The Vulkan renderer did not start: {0}"
msgstr "De Vulkan-renderer is niet gestart: {0}"

msgid "Touchpad click + Options: the in-game menu (screens, picture, volume, controls, the library)"
msgstr "Touchpadklik + OPTIONS: het gamemenu (schermen, beeld, volume, besturing, de bibliotheek)"

