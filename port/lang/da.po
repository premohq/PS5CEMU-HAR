#: port/app/ingame.cpp:194 port/app/ingame3ds.cpp:471
#, menu
msgid "Main screen"
msgstr "Hovedskærm"

#: port/app/ingame.cpp:195
#, menu
msgid "Which picture fills the TV: the TV's or the GamePad's. In the game, touchpad click + L1 swaps them."
msgstr "Hvilket billede der fylder tv’et: TV’ets eller GamePad’ens. I spillet bytter klik på touchpladen + L1 om på dem."

#: port/app/ingame.cpp:196
#, menu
msgid "TV in a corner"
msgstr "TV i hjørnet"

#: port/app/ingame.cpp:196
#, menu
msgid "GamePad in a corner"
msgstr "GamePad i hjørnet"

#: port/app/ingame.cpp:197
#, menu
msgid "The other screen, small in the bottom right corner. In the game, touchpad click + R1."
msgstr "Den anden skærm, lille i nederste højre hjørne. I spillet: klik på touchpladen + R1."

#: port/app/ingame.cpp:198
#, menu
msgid "Picture"
msgstr "Billede"

#: port/app/ingame.cpp:198
#, menu
msgid "Its own shape"
msgstr "Egen form"

#: port/app/ingame.cpp:199
#, menu
msgid "Its own shape keeps the picture's proportions, with bars where they differ from the screen's; Stretched fills it."
msgstr "Egen form bevarer billedets proportioner, med kanter hvor de afviger fra skærmens; Strakt fylder den ud."

#: port/app/ingame.cpp:201 port/app/ingame3ds.cpp:477 port/app/ingame3ds.cpp:486 port/frontend/shell/settings.cpp:183
#, menu
msgid "Graphics"
msgstr "Grafik"

#: port/app/ingame.cpp:202
#, menu
msgid "Upscaling, Cemu's accuracy settings and the performance overlay. Kept for the next games."
msgstr "Opskalering, Cemus nøjagtighedsindstillinger og ydelsesoverlejringen. Gemmes til de næste spil."

#: port/app/ingame.cpp:203 port/frontend/shell/settings.cpp:451
#, menu
msgid "Upscaling to 4K"
msgstr "Opskalering til 4K"

#: port/app/ingame.cpp:204
#, menu
msgid "How the picture is scaled to the screen: Bicubic is sharp, Hermite softer, Bilinear softer still."
msgstr "Hvordan billedet skaleres til skærmen: Bikubisk er skarp, Hermite blødere, Bilineær endnu blødere."

#: port/app/ingame.cpp:205
#, menu
msgid "Accurate barriers"
msgstr "Præcise barrierer"

#: port/app/ingame.cpp:206
#, menu
msgid "Off can raise the frame rate, but some games then flicker or show wrong shadows. It changes at once."
msgstr "Fra kan hæve billedhastigheden, men nogle spil flimrer så eller viser forkerte skygger. Gælder med det samme."

#: port/app/ingame.cpp:207 port/frontend/shell/settings.cpp:474 port/frontend/shell/settings.cpp:495
#, menu
msgid "Async shader compile"
msgstr "Asynkron shaderkompilering"

#: port/app/ingame.cpp:208
#, menu
msgid "On, new shaders build while the game carries on: no stutter, but things may be missing for a moment."
msgstr "Til: nye shaders bygges, mens spillet kører videre. Ingen hakken, men noget kan mangle et øjeblik."

#: port/app/ingame.cpp:209 port/frontend/shell/settings.cpp:462
#, menu
msgid "Frame pacing"
msgstr "Jævn billedrytme"

