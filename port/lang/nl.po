msgstr "Azahar stopte halverwege; /data/ps5cemu/azahar/log/azahar_log.txt zegt waarom"

#: port/azahar/core.cpp:1005
#, menu
msgid "it is not a CIA Azahar can install"
msgstr "het is geen CIA die Azahar kan installeren"

