msgctxt "status"
msgid "Won't start"
msgstr "Ne démarre pas"

msgid "the PS5 Vulkan driver did not start"
msgstr "le pilote Vulkan de la PS5 n’a pas démarré"

msgid "PS5CEMU-HAR cannot write to {0}. Is the HEN loaded?"
msgstr "PS5CEMU-HAR ne peut pas écrire dans {0}. Le HEN est-il chargé ?"

msgid "PS5CEMU-HAR cannot create the MLC folder {0}"
msgstr "PS5CEMU-HAR ne peut pas créer le dossier MLC {0}"

msgid "The game's base files were not found."
msgstr "Les fichiers de base du jeu sont introuvables."

msgid "The game could not be mounted. Check that its files are still in the game files folder."
msgstr "Le jeu n’a pas pu être monté. Vérifiez que ses fichiers sont toujours dans le dossier des jeux."

msgid "The game could not be started."
msgstr "Le jeu n’a pas pu être lancé."

msgid "This is not a Wii U game PS5CEMU-HAR can start."
msgstr "Ce n’est pas un jeu Wii U que PS5CEMU-HAR peut lancer."

msgid "Its disc key is missing from /data/ps5cemu/keys.txt."
msgstr "Sa clé de disque manque dans /data/ps5cemu/keys.txt."

msgid "Its title.tik is missing."
msgstr "Son fichier title.tik manque."

msgid "The executable could not be started."
msgstr "L’exécutable n’a pas pu être lancé."

msgid "The Vulkan renderer did not start: {0}"
msgstr "Le moteur de rendu Vulkan n’a pas démarré : {0}"

msgid "Touchpad click + Options: the in-game menu (screens, picture, volume, controls, the library)"
msgstr "Clic du pavé tactile + OPTIONS : le menu en jeu (écrans, image, volume, commandes, bibliothèque)"

