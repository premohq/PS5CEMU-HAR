msgid "Issues"
msgstr "Problemas"

msgctxt "status"
msgid "Crashes"
msgstr "Se cuelga"

msgctxt "status"
msgid "Won't start"
msgstr "No arranca"

msgid "the PS5 Vulkan driver did not start"
msgstr "el controlador Vulkan de la PS5 no se ha iniciado"

msgid "PS5CEMU-HAR cannot write to {0}. Is the HEN loaded?"
msgstr "PS5CEMU-HAR no puede escribir en {0}. ¿Está cargado el HEN?"

msgid "PS5CEMU-HAR cannot create the MLC folder {0}"
msgstr "PS5CEMU-HAR no puede crear la carpeta MLC {0}"

msgid "The game's base files were not found."
msgstr "No se han encontrado los archivos base del juego."

msgid "The game could not be mounted. Check that its files are still in the game files folder."
msgstr "No se ha podido montar el juego. Comprueba que sus archivos siguen en la carpeta de juegos."

msgid "The game could not be started."
msgstr "No se ha podido iniciar el juego."

msgid "This is not a Wii U game PS5CEMU-HAR can start."
msgstr "No es un juego de Wii U que PS5CEMU-HAR pueda iniciar."

msgid "Its disc key is missing from /data/ps5cemu/keys.txt."
msgstr "Falta su clave de disco en /data/ps5cemu/keys.txt."

msgid "Its title.tik is missing."
msgstr "Falta su title.tik."

msgid "The executable could not be started."
msgstr "No se ha podido iniciar el ejecutable."

msgid "The Vulkan renderer did not start: {0}"
msgstr "El renderizador Vulkan no se ha iniciado: {0}"

msgid "Touchpad click + Options: the in-game menu (screens, picture, volume, controls, the library)"
msgstr "Clic en el panel táctil + OPTIONS: el menú del juego (pantallas, imagen, volumen, controles, biblioteca)"

