msgid "Playable"
msgstr "Spielbar"

msgctxt "status"
msgid "Issues"
msgstr "Probleme"

msgctxt "status"
msgid "Crashes"
msgstr "Stürzt ab"

msgctxt "status"
msgid "Won't start"
msgstr "Startet nicht"

msgid "the PS5 Vulkan driver did not start"
msgstr "der Vulkan-Treiber der PS5 ist nicht gestartet"

msgid "PS5CEMU-HAR cannot write to {0}. Is the HEN loaded?"
msgstr "PS5CEMU-HAR kann nicht in {0} schreiben. Ist der HEN geladen?"

msgid "PS5CEMU-HAR cannot create the MLC folder {0}"
msgstr "PS5CEMU-HAR kann den MLC-Ordner {0} nicht anlegen"

msgid "The game's base files were not found."
msgstr "Die Basisdateien des Spiels wurden nicht gefunden."

msgid "The game could not be mounted. Check that its files are still in the game files folder."
msgstr "Das Spiel konnte nicht eingebunden werden. Prüfe, ob seine Dateien noch im Spieleordner liegen."

msgid "The game could not be started."
msgstr "Das Spiel konnte nicht gestartet werden."

msgid "This is not a Wii U game PS5CEMU-HAR can start."
msgstr "Das ist kein Wii U-Spiel, das PS5CEMU-HAR starten kann."

msgid "Its disc key is missing from /data/ps5cemu/keys.txt."
msgstr "Sein Disc-Schlüssel fehlt in /data/ps5cemu/keys.txt."

msgid "Its title.tik is missing."
msgstr "Seine title.tik fehlt."

msgid "The executable could not be started."
msgstr "Die ausführbare Datei konnte nicht gestartet werden."

msgid "The Vulkan renderer did not start: {0}"
msgstr "Der Vulkan-Renderer ist nicht gestartet: {0}"

msgid "Touchpad click + Options: the in-game menu (screens, picture, volume, controls, the library)"
msgstr "Touchpad-Klick + OPTIONS: das Spielmenü (Bildschirme, Bild, Lautstärke, Steuerung, Bibliothek)"

