From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ps5cemu <ps5cemu@localhost>
Date: Wed, 14 Oct 2026 16:00:00 +0000
Subject: [PATCH] PS5: Artic Setup says which keys it lacks before it copies
 anything

The console unique data the 3DS sends is decrypted, and its CTCert
checked, with the otpKey, otpIV and the ECC rootPublicXY. Azahar has
them built in (ENABLE_BUILTIN_KEYBLOB), but an aes_keys.txt takes the
place of all of its keys, and one without these let the setup copy the
3DS's files into the NAND and then end with "Some console unique data
is invalid", which named nothing (#45). The keys are now checked first,
and the 3DS's screen says which ones the file lacks and what to do.
---
 src/core/loader/artic.cpp | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/src/core/loader/artic.cpp b/src/core/loader/artic.cpp
index bcd843c..f51d166 100644
--- a/src/core/loader/artic.cpp
+++ b/src/core/loader/artic.cpp
@@ -32,6 +32,8 @@
 #include "core/hle/service/fs/archive.h"
 #include "core/hle/service/fs/fs_user.h"
 #include "core/hle/service/hid/hid_user.h"
+#include "core/hw/aes/key.h"
+#include "core/hw/ecc.h"
 #include "core/hw/unique_data.h"
 #include "core/loader/artic.h"
 #include "core/loader/smdh.h"
@@ -412,6 +414,25 @@ ResultStatus Apploader_Artic::Load(std::shared_ptr<Kernel::Process>& process) {
 
     if (is_initial_setup) {
 
+        // PS5: the console unique data is checked with the OTP key and IV and the ECC root key,
+        // Azahar's own (ENABLE_BUILTIN_KEYBLOB) unless an aes_keys.txt takes the place of all of
+        // them. One without these let the setup copy everything and then end with "Some console
+        // unique data is invalid": said on the 3DS before anything is copied instead.
+        HW::AES::InitKeys();
+        const auto [otp_key, otp_iv] = HW::AES::GetOTPKeyIV();
+        const auto all_zero = [](const auto& bytes) {
+            return std::all_of(bytes.begin(), bytes.end(), [](u8 b) { return b == 0; });
+        };
+        if (all_zero(otp_key) || all_zero(otp_iv) || all_zero(HW::ECC::GetRootPublicKey().xy)) {
+            LOG_ERROR(Loader, "Artic Setup: aes_keys.txt has no otpKey, otpIV or rootPublicXY");
+            client->LogOnServer(Network::ArticBaseCommon::LogOnServerType::LOG_ERROR,
+                                "aes_keys.txt on the PS5 lacks otpKey,\n"
+                                "    otpIV or rootPublicXY, and takes\n"
+                                "    the place of Azahar's own keys:\n"
+                                "    remove it, or add them.\n    Aborting...");
+            return ResultStatus::ErrorArtic;
+        }
+
         // If there is already a console linked, check it's the same device.
         // Otherwise it could cause weird issues with account save data.
         if (HW::UniqueData::IsFullConsoleLinked()) {
