msgctxt "status"
msgid "Playable"
msgstr "Играбельно"

msgctxt "status"
msgid "Issues"
msgstr "Есть проблемы"

msgctxt "status"
msgid "Crashes"
msgstr "Вылетает"

msgctxt "status"
msgid "Won't start"
msgstr "Не запускается"

msgid "the PS5 Vulkan driver did not start"
msgstr "драйвер Vulkan на PS5 не запустился"

msgid "PS5CEMU-HAR cannot write to {0}. Is the HEN loaded?"
msgstr "PS5CEMU-HAR не может записывать в {0}. HEN загружен?"

msgid "PS5CEMU-HAR cannot create the MLC folder {0}"
msgstr "PS5CEMU-HAR не может создать папку MLC {0}"

msgid "The game's base files were not found."
msgstr "Базовые файлы игры не найдены."

msgid "The game could not be mounted. Check that its files are still in the game files folder."
msgstr "Не удалось смонтировать игру. Проверьте, что её файлы всё ещё в папке с играми."

msgid "The game could not be started."
msgstr "Не удалось запустить игру."

msgid "This is not a Wii U game PS5CEMU-HAR can start."
msgstr "Это не игра для Wii U, которую может запустить PS5CEMU-HAR."

msgid "Its disc key is missing from /data/ps5cemu/keys.txt."
msgstr "Ключа её диска нет в /data/ps5cemu/keys.txt."

msgid "Its title.tik is missing."
msgstr "Нет её файла title.tik."

msgid "The executable could not be started."
msgstr "Не удалось запустить исполняемый файл."

msgid "The Vulkan renderer did not start: {0}"
msgstr "Рендерер Vulkan не запустился: {0}"

msgid "Touchpad click + Options: the in-game menu (screens, picture, volume, controls, the library)"
msgstr "Нажатие сенсорной панели + OPTIONS: игровое меню (экраны, изображение, громкость, управление, библиотека)"

