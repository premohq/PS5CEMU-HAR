msgctxt "status"
msgid "Playable"
msgstr "Grywalna"

msgctxt "status"
msgid "Issues"
msgstr "Problemy"

msgctxt "status"
msgid "Crashes"
msgstr "Zawiesza się"

msgctxt "status"
msgid "Won't start"
msgstr "Nie uruchamia się"

msgid "the PS5 Vulkan driver did not start"
msgstr "sterownik Vulkan na PS5 się nie uruchomił"

msgid "PS5CEMU-HAR cannot write to {0}. Is the HEN loaded?"
msgstr "PS5CEMU-HAR nie może zapisywać w {0}. Czy HEN jest załadowany?"

msgid "PS5CEMU-HAR cannot create the MLC folder {0}"
msgstr "PS5CEMU-HAR nie może utworzyć folderu MLC {0}"

msgid "The game's base files were not found."
msgstr "Nie znaleziono plików podstawowych gry."

msgid "The game could not be mounted. Check that its files are still in the game files folder."
msgstr "Nie udało się zamontować gry. Sprawdź, czy jej pliki wciąż są w folderze z grami."

msgid "The game could not be started."
msgstr "Nie udało się uruchomić gry."

msgid "This is not a Wii U game PS5CEMU-HAR can start."
msgstr "To nie jest gra na Wii U, którą PS5CEMU-HAR może uruchomić."

msgid "Its disc key is missing from /data/ps5cemu/keys.txt."
msgstr "W /data/ps5cemu/keys.txt brakuje klucza jej płyty."

msgid "Its title.tik is missing."
msgstr "Brakuje jej pliku title.tik."

msgid "The executable could not be started."
msgstr "Nie udało się uruchomić pliku wykonywalnego."

msgid "The Vulkan renderer did not start: {0}"
msgstr "Renderer Vulkan się nie uruchomił: {0}"

msgid "Touchpad click + Options: the in-game menu (screens, picture, volume, controls, the library)"
msgstr "Kliknięcie panelu dotykowego + OPTIONS: menu gry (ekrany, obraz, głośność, sterowanie, biblioteka)"

