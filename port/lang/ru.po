msgid "Keys for encrypted discs"
msgstr "Ключи для зашифрованных дисков"

#: port/frontend/shell/setup.cpp:259
msgid "Encrypted .wud and .wux dumps need their disc keys in {0}/keys.txt, one a line. Decrypted dumps, .wua files and folders with code, content and meta need none."
msgstr "Зашифрованным дампам .wud и .wux нужны ключи их дисков в {0}/keys.txt, по одному в строке. Расшифрованным дампам, файлам .wua и папкам с code, content и meta они не нужны."

#: port/frontend/shell/setup.cpp:267
msgid "3DS keys"
msgstr "Ключи 3DS"

