msgstr "Azahar zatrzymał się w połowie; /data/ps5cemu/azahar/log/azahar_log.txt podaje przyczynę"

#: port/azahar/core.cpp:1005
#, menu
msgid "it is not a CIA Azahar can install"
msgstr "to nie jest CIA, który Azahar może zainstalować"

