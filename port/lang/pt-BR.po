msgid "Crashes"
msgstr "Trava"

msgctxt "status"
msgid "Won't start"
msgstr "Não inicia"

msgid "the PS5 Vulkan driver did not start"
msgstr "o driver Vulkan do PS5 não iniciou"

msgid "PS5CEMU-HAR cannot write to {0}. Is the HEN loaded?"
msgstr "O PS5CEMU-HAR não consegue gravar em {0}. O HEN está carregado?"

msgid "PS5CEMU-HAR cannot create the MLC folder {0}"
msgstr "O PS5CEMU-HAR não consegue criar a pasta MLC {0}"

msgid "The game's base files were not found."
msgstr "Os arquivos base do jogo não foram encontrados."

msgid "The game could not be mounted. Check that its files are still in the game files folder."
msgstr "Não foi possível montar o jogo. Verifique se os arquivos dele ainda estão na pasta de jogos."

msgid "The game could not be started."
msgstr "Não foi possível iniciar o jogo."

msgid "This is not a Wii U game PS5CEMU-HAR can start."
msgstr "Este não é um jogo de Wii U que o PS5CEMU-HAR consiga iniciar."

msgid "Its disc key is missing from /data/ps5cemu/keys.txt."
msgstr "A chave do disco dele está faltando em /data/ps5cemu/keys.txt."

msgid "Its title.tik is missing."
msgstr "O title.tik dele está faltando."

msgid "The executable could not be started."
msgstr "Não foi possível iniciar o executável."

msgid "The Vulkan renderer did not start: {0}"
msgstr "O renderizador Vulkan não iniciou: {0}"

msgid "Touchpad click + Options: the in-game menu (screens, picture, volume, controls, the library)"
msgstr "Clique no touch pad + OPTIONS: o menu do jogo (telas, imagem, volume, controles, biblioteca)"

