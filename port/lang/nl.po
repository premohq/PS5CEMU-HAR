msgid "Preview"
msgstr "Voorbeeld"

msgid "{0}, with no border."
msgstr "{0}, zonder rand."

msgid "{0}, on the {1} border."
msgstr "{0}, met de rand {1}."

msgid "The bottom screen is the touchpad: click to tap, hold the click to drag."
msgstr "Het onderscherm is de touchpad: klik om te tikken, houd de klik vast om te slepen."

msgid "About this setting"
msgstr "Over deze instelling"

msgid "{0} GB free"
msgstr "{0} GB vrij"

msgid "Storage"
