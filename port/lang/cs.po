#. the 3DS's top and bottom screens
#: port/app/ingame.cpp:183 port/app/ingame3ds.cpp:447
#, menu
msgid "Main screen"
msgstr "Hlavní obrazovka"

#: port/app/ingame.cpp:184
#, menu
msgid "Which picture fills the TV: the TV's or the GamePad's. In the game, touchpad click + L1 swaps them."
msgstr "Který obraz vyplní televizor: z TV, nebo z GamePadu. Ve hře je prohodí kliknutí na dotykovou plochu + L1."

#: port/app/ingame.cpp:185
#, menu
msgid "TV in a corner"
msgstr "TV v rohu"

#: port/app/ingame.cpp:185
#, menu
msgid "GamePad in a corner"
msgstr "GamePad v rohu"

#: port/app/ingame.cpp:186
#, menu
msgid "The other screen, small in the bottom right corner. In the game, touchpad click + R1."
msgstr "Druhá obrazovka, malá v pravém dolním rohu. Ve hře: kliknutí na dotykovou plochu + R1."

#: port/app/ingame.cpp:187
#, menu
msgid "Picture"
msgstr "Obraz"

#: port/app/ingame.cpp:187
#, menu
msgid "Its own shape"
msgstr "Vlastní tvar"

#: port/app/ingame.cpp:188
#, menu
msgid "Its own shape keeps the picture's proportions, with bars where they differ from the screen's; Stretched fills it."
msgstr "Vlastní tvar zachová poměr stran obrazu, s pruhy tam, kde se liší od obrazovky; Roztažený ji vyplní celou."

#: port/app/ingame.cpp:190 port/app/ingame3ds.cpp:452 port/frontend/shell/settings.cpp:96 port/frontend/shell/settings.cpp:102
#, menu
msgid "Graphics"
msgstr "Grafika"

#: port/app/ingame.cpp:191
#, menu
msgid "Upscaling, Cemu's accuracy settings and the performance overlay. Kept for the next games."
msgstr "Zvětšování, nastavení přesnosti Cemu a překryv výkonu. Platí i pro další hry."

#: port/app/ingame.cpp:192 port/frontend/shell/settings.cpp:355
#, menu
msgid "Upscaling to 4K"
msgstr "Zvětšování na 4K"

#: port/app/ingame.cpp:193
#, menu
msgid "How the picture is scaled to the screen: Bicubic is sharp, Hermite softer, Bilinear softer still."
msgstr "Jak se obraz zvětšuje na obrazovku: Bikubický je ostrý, Hermite měkčí, Bilineární ještě měkčí."

#: port/app/ingame.cpp:194
#, menu
msgid "Accurate barriers"
msgstr "Přesné bariéry"

#: port/app/ingame.cpp:195
#, menu
msgid "Off can raise the frame rate, but some games then flicker or show wrong shadows. It changes at once."
msgstr "Vypnutí může zvýšit snímkovou frekvenci, ale některé hry pak blikají nebo ukazují špatné stíny. Platí hned."

#: port/app/ingame.cpp:196 port/frontend/shell/settings.cpp:370
#, menu
msgid "Async shader compile"
msgstr "Asynchronní kompilace shaderů"

#: port/app/ingame.cpp:197
#, menu
msgid "On, new shaders build while the game carries on: no stutter, but things may be missing for a moment."
msgstr "Zapnuto: nové shadery se sestavují, zatímco hra běží dál. Bez záseků, ale něco může na chvíli chybět."

#: port/app/ingame.cpp:198 port/frontend/shell/settings.cpp:363
#, menu
msgid "Frame pacing"
msgstr "Rovnoměrné snímky"

#: port/app/ingame.cpp:199
#, menu
msgid "Holds the game to an even rate: 60 fps for 4K at 120 Hz, 30 for 8K at 60 Hz. Off shows each frame when it is done."
msgstr "Drží hru v rovnoměrném tempu: 60 fps pro 4K při 120 Hz, 30 pro 8K při 60 Hz. Vypnuto zobrazí každý snímek, jakmile je hotový."

#: port/app/ingame.cpp:200 port/app/ingame3ds.cpp:458 port/frontend/shell/settings.cpp:368
#, menu
msgid "Performance overlay"
msgstr "Překryv výkonu"

#: port/app/ingame.cpp:201
#, menu
msgid "Frames per second, CPU and memory use in the top left corner, as Cemu shows them."
msgstr "Snímky za sekundu, využití CPU a paměti v levém horním rohu, jak je ukazuje Cemu."

#: port/app/ingame.cpp:214 port/app/ingame.cpp:244
#, menu
msgid "{0} (next start)"
msgstr "{0} (od příštího spuštění)"

#: port/app/ingame.cpp:215
#, menu
msgid "This pack replaces textures: the game shows the change when it starts again."
msgstr "Tento balíček nahrazuje textury: hra ukáže změnu při příštím spuštění."

#: port/app/ingame.cpp:216
#, menu
msgid "Cross turns it on or off; the game shows it at once."
msgstr "Křížek ho zapne nebo vypne; hra to ukáže hned."

#: port/app/ingame.cpp:224 port/frontend/shell/pages.cpp:268 port/frontend/shell/pages.cpp:357
#, menu
msgid "Preset"
msgstr "Předvolba"

#: port/app/ingame.cpp:226
#, menu
msgid "Left and Right choose another; the game shows it at once."
msgstr "Doleva a doprava vyberou jinou; hra ji ukáže hned."

#: port/app/ingame.cpp:230
#, menu
msgid "None for this game"
msgstr "Pro tuto hru žádné"

#: port/app/ingame.cpp:230
#, menu
msgid "Reading the packs…"
msgstr "Načítání balíčků…"

#: port/app/ingame.cpp:231
#, menu
msgid "The community graphic packs have none for this game."
msgstr "Grafické balíčky komunity pro tuto hru žádný nemají."

#: port/app/ingame.cpp:233 port/app/ingame.cpp:304 port/frontend/shell/home.cpp:469 port/frontend/shell/hub.cpp:224 port/frontend/shell/pages.cpp:292 port/frontend/shell/shell.cpp:1119
#, menu
msgid "Graphic packs"
msgstr "Grafické balíčky"

#. amiibo is Nintendo's name for its figures, as it writes it in the language
#: port/app/ingame.cpp:233 port/app/ingame.cpp:269 port/app/ingame.cpp:304 port/app/ingame3ds.cpp:435
#, menu
msgid "None"
msgstr "Žádný"

#: port/app/ingame.cpp:233 port/app/ingame.cpp:262 port/frontend/shell/home.cpp:469
#, menu
msgid "{0} on"
msgid_plural "{0} on"
msgstr[0] "{0} zapnutý"
msgstr[1] "{0} zapnuté"
msgstr[2] "{0} zapnutých"

#: port/app/ingame.cpp:234
#, menu
msgid "The game's community graphic packs: resolution, frame rate and mods, as Cemu's Graphic Packs window has them."
msgstr "Grafické balíčky komunity pro tuto hru: rozlišení, snímková frekvence a mody, jako v okně Graphic Packs v Cemu."

#: port/app/ingame.cpp:245
#, menu
msgid "The game sees the change when it starts again: the portal is plugged in as a game starts."
msgstr "Hra uvidí změnu při příštím spuštění: portál se připojuje při spuštění hry."

#: port/app/ingame.cpp:246
#, menu
msgid "Plugged in as a game starts, as in Cemu. Its figures are below while it is on."
msgstr "Připojuje se při spuštění hry, jako v Cemu. Jeho figurky jsou níže, dokud je zapnutý."

