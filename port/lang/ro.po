msgstr "Azahar s-a oprit la jumătate; /data/ps5cemu/azahar/log/azahar_log.txt spune de ce"

#: port/azahar/core.cpp:1005
#, menu
msgid "it is not a CIA Azahar can install"
msgstr "nu e un CIA pe care Azahar îl poate instala"

