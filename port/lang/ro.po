msgid "Playable"
msgstr "Jucabil"

msgctxt "status"
msgid "Issues"
msgstr "Probleme"

msgctxt "status"
msgid "Crashes"
msgstr "Se blochează"

msgctxt "status"
msgid "Won't start"
msgstr "Nu pornește"

msgid "the PS5 Vulkan driver did not start"
msgstr "driverul Vulkan al PS5 nu a pornit"

msgid "PS5CEMU-HAR cannot write to {0}. Is the HEN loaded?"
msgstr "PS5CEMU-HAR nu poate scrie în {0}. Este HEN-ul încărcat?"

msgid "PS5CEMU-HAR cannot create the MLC folder {0}"
msgstr "PS5CEMU-HAR nu poate crea folderul MLC {0}"

msgid "The game's base files were not found."
msgstr "Fișierele de bază ale jocului nu au fost găsite."

msgid "The game could not be mounted. Check that its files are still in the game files folder."
msgstr "Jocul nu a putut fi montat. Verifică dacă fișierele lui sunt încă în folderul de jocuri."

msgid "The game could not be started."
msgstr "Jocul nu a putut fi pornit."

msgid "This is not a Wii U game PS5CEMU-HAR can start."
msgstr "Acesta nu este un joc Wii U pe care PS5CEMU-HAR îl poate porni."

msgid "Its disc key is missing from /data/ps5cemu/keys.txt."
msgstr "Cheia discului lipsește din /data/ps5cemu/keys.txt."

msgid "Its title.tik is missing."
msgstr "Fișierul title.tik lipsește."

msgid "The executable could not be started."
msgstr "Executabilul nu a putut fi pornit."

msgid "The Vulkan renderer did not start: {0}"
msgstr "Randatorul Vulkan nu a pornit: {0}"

msgid "Touchpad click + Options: the in-game menu (screens, picture, volume, controls, the library)"
msgstr "Clic pe touchpad + OPTIONS: meniul din joc (ecrane, imagine, volum, comenzi, biblioteca)"

