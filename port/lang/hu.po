msgctxt "status"
msgid "Playable"
msgstr "Játszható"

msgctxt "status"
msgid "Issues"
msgstr "Hibák"

msgctxt "status"
msgid "Crashes"
msgstr "Összeomlik"

msgctxt "status"
msgid "Won't start"
msgstr "Nem indul"

msgid "the PS5 Vulkan driver did not start"
msgstr "a PS5 Vulkan-illesztőprogramja nem indult el"

msgid "PS5CEMU-HAR cannot write to {0}. Is the HEN loaded?"
msgstr "A PS5CEMU-HAR nem tud írni ide: {0}. Be van töltve a HEN?"

msgid "PS5CEMU-HAR cannot create the MLC folder {0}"
msgstr "A PS5CEMU-HAR nem tudja létrehozni az MLC-mappát: {0}"

msgid "The game's base files were not found."
msgstr "A játék alapfájljai nem találhatók."

msgid "The game could not be mounted. Check that its files are still in the game files folder."
msgstr "A játékot nem sikerült csatolni. Ellenőrizd, hogy a fájljai még a játékok mappájában vannak-e."

msgid "The game could not be started."
msgstr "A játékot nem sikerült elindítani."

msgid "This is not a Wii U game PS5CEMU-HAR can start."
msgstr "Ez nem olyan Wii U-játék, amelyet a PS5CEMU-HAR el tud indítani."

msgid "Its disc key is missing from /data/ps5cemu/keys.txt."
msgstr "A lemezkulcsa hiányzik a /data/ps5cemu/keys.txt fájlból."

msgid "Its title.tik is missing."
msgstr "Hiányzik a title.tik fájlja."

msgid "The executable could not be started."
msgstr "A futtatható fájlt nem sikerült elindítani."

msgid "The Vulkan renderer did not start: {0}"
msgstr "A Vulkan-megjelenítő nem indult el: {0}"

msgid "Touchpad click + Options: the in-game menu (screens, picture, volume, controls, the library)"
msgstr "Érintőpanel-kattintás + OPTIONS: a játék menüje (képernyők, kép, hangerő, irányítás, könyvtár)"

