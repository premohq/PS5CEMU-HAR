#: port/app/accounts.cpp:68 port/frontend/shell/settings.cpp:1614
msgid "The Wii U has twelve accounts at most."
msgstr "Wii U의 계정은 최대 12개입니다."

#: port/app/accounts.cpp:104
msgid "The last account cannot be deleted."
msgstr "마지막 계정은 삭제할 수 없습니다."

#: port/app/accounts.cpp:109
msgid "Games start on this account: choose another one first."
msgstr "게임이 이 계정으로 실행됩니다. 먼저 다른 계정을 선택하세요."

#: port/app/accounts.cpp:128
msgid "There is no such account."
msgstr "그런 계정이 없습니다."

#. RetroAchievements did not sign in: its own words ({0}) follow
#: port/app/achievements.cpp:255
msgid "RetroAchievements did not accept the user name or password."
msgstr "RetroAchievements에서 사용자 이름 또는 비밀번호를 받아들이지 않았습니다."

#: port/app/achievements.cpp:256
msgid "RetroAchievements did not answer. Is the PS5 online?"
msgstr "RetroAchievements에서 응답이 없습니다. PS5가 온라인인지 확인하세요."

#: port/app/achievements.cpp:257
msgid "RetroAchievements: {0}"
msgstr "RetroAchievements: {0}"

#. a RetroAchievements unlock, as the PS5's notification: its points ({0}) and title ({1})
#: port/app/achievements.cpp:294
msgid "Achievement unlocked: {1} ({0} point)"
msgid_plural "Achievement unlocked: {1} ({0} points)"
msgstr[0] "도전 과제 달성: {1}({0}포인트)"

#. every RetroAchievements achievement of a game earned ({0}: the game's name)
#: port/app/achievements.cpp:301
msgid "Every achievement of {0} is yours"
msgstr "{0}의 모든 도전 과제를 달성했습니다"

#. as a DS game starts: how many of its RetroAchievements are earned ({0} of {1})
#: port/app/achievements.cpp:340
msgid "RetroAchievements: {0} of {1} achievements"
msgstr "RetroAchievements: 도전 과제 {1}개 중 {0}개 달성"

#: port/app/achievements.cpp:494
msgid "Sign in to RetroAchievements in Settings > Online."
msgstr "설정 > 온라인에서 RetroAchievements에 로그인하세요."

#: port/app/achievements.cpp:500
msgid "Looking for this game's achievements…"
msgstr "이 게임의 도전 과제를 찾는 중…"

#: port/app/achievements.cpp:505
msgid "RetroAchievements has no achievements for this game."
msgstr "RetroAchievements에 이 게임의 도전 과제가 없습니다."

#: port/app/achievements.cpp:510
msgid "RetroAchievements could not be reached. The game plays on without them."
msgstr "RetroAchievements에 연결하지 못했습니다. 도전 과제 없이 게임을 계속합니다."

#. a game's RetroAchievements: earned of all ({0} of {1}), then points earned of all ({2} of {3})
#: port/app/achievements.cpp:519
msgid "{0} of {1} achievements · {2} of {3} points"
msgstr "도전 과제 {1}개 중 {0}개 · {3}포인트 중 {2}포인트"

