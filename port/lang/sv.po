msgid "Playable"
msgstr "Spelbart"

msgctxt "status"
msgid "Issues"
msgstr "Problem"

msgctxt "status"
msgid "Crashes"
msgstr "Kraschar"

msgctxt "status"
msgid "Won't start"
msgstr "Startar inte"

msgid "the PS5 Vulkan driver did not start"
msgstr "PS5:ans Vulkan-drivrutin startade inte"

msgid "PS5CEMU-HAR cannot write to {0}. Is the HEN loaded?"
msgstr "PS5CEMU-HAR kan inte skriva till {0}. Är HEN laddad?"

msgid "PS5CEMU-HAR cannot create the MLC folder {0}"
msgstr "PS5CEMU-HAR kan inte skapa MLC-mappen {0}"

msgid "The game's base files were not found."
msgstr "Spelets basfiler hittades inte."

msgid "The game could not be mounted. Check that its files are still in the game files folder."
msgstr "Spelet kunde inte monteras. Kontrollera att dess filer fortfarande finns i spelmappen."

msgid "The game could not be started."
msgstr "Spelet kunde inte startas."

msgid "This is not a Wii U game PS5CEMU-HAR can start."
msgstr "Det här är inget Wii U-spel som PS5CEMU-HAR kan starta."

msgid "Its disc key is missing from /data/ps5cemu/keys.txt."
msgstr "Dess skivnyckel saknas i /data/ps5cemu/keys.txt."

msgid "Its title.tik is missing."
msgstr "Dess title.tik saknas."

msgid "The executable could not be started."
msgstr "Den körbara filen kunde inte startas."

msgid "The Vulkan renderer did not start: {0}"
msgstr "Vulkan-renderaren startade inte: {0}"

msgid "Touchpad click + Options: the in-game menu (screens, picture, volume, controls, the library)"
msgstr "Styrplattsklick + OPTIONS: spelmenyn (skärmar, bild, volym, kontroller, biblioteket)"

