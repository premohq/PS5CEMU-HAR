msgid "Playable"
msgstr "Можна грати"

msgctxt "status"
msgid "Issues"
msgstr "Є проблеми"

msgctxt "status"
msgid "Crashes"
msgstr "Вилітає"

msgctxt "status"
msgid "Won't start"
msgstr "Не запускається"

msgid "the PS5 Vulkan driver did not start"
msgstr "драйвер Vulkan на PS5 не запустився"

msgid "PS5CEMU-HAR cannot write to {0}. Is the HEN loaded?"
msgstr "PS5CEMU-HAR не може записувати в {0}. HEN завантажено?"

msgid "PS5CEMU-HAR cannot create the MLC folder {0}"
msgstr "PS5CEMU-HAR не може створити теку MLC {0}"

msgid "The game's base files were not found."
msgstr "Базові файли гри не знайдено."

msgid "The game could not be mounted. Check that its files are still in the game files folder."
msgstr "Не вдалося змонтувати гру. Перевірте, чи її файли досі в теці з іграми."

msgid "The game could not be started."
msgstr "Не вдалося запустити гру."

msgid "This is not a Wii U game PS5CEMU-HAR can start."
msgstr "Це не гра для Wii U, яку може запустити PS5CEMU-HAR."

msgid "Its disc key is missing from /data/ps5cemu/keys.txt."
msgstr "Ключа її диска немає в /data/ps5cemu/keys.txt."

msgid "Its title.tik is missing."
msgstr "Немає її файлу title.tik."

msgid "The executable could not be started."
msgstr "Не вдалося запустити виконуваний файл."

msgid "The Vulkan renderer did not start: {0}"
msgstr "Рендерер Vulkan не запустився: {0}"

msgid "Touchpad click + Options: the in-game menu (screens, picture, volume, controls, the library)"
msgstr "Натискання сенсорної панелі + OPTIONS: ігрове меню (екрани, зображення, гучність, керування, бібліотека)"

