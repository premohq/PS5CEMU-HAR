msgid "Playable"
msgstr "Giocabile"

msgctxt "status"
msgid "Issues"
msgstr "Problemi"

msgctxt "status"
msgid "Crashes"
msgstr "Si blocca"

msgctxt "status"
msgid "Won't start"
msgstr "Non si avvia"

msgid "the PS5 Vulkan driver did not start"
msgstr "il driver Vulkan della PS5 non si è avviato"

msgid "PS5CEMU-HAR cannot write to {0}. Is the HEN loaded?"
msgstr "PS5CEMU-HAR non può scrivere in {0}. L’HEN è caricato?"

msgid "PS5CEMU-HAR cannot create the MLC folder {0}"
msgstr "PS5CEMU-HAR non può creare la cartella MLC {0}"

msgid "The game's base files were not found."
msgstr "I file di base del gioco non sono stati trovati."

msgid "The game could not be mounted. Check that its files are still in the game files folder."
msgstr "Impossibile montare il gioco. Controlla che i suoi file siano ancora nella cartella dei giochi."

msgid "The game could not be started."
msgstr "Impossibile avviare il gioco."

msgid "This is not a Wii U game PS5CEMU-HAR can start."
msgstr "Non è un gioco Wii U che PS5CEMU-HAR può avviare."

msgid "Its disc key is missing from /data/ps5cemu/keys.txt."
msgstr "Manca la sua chiave del disco in /data/ps5cemu/keys.txt."

msgid "Its title.tik is missing."
msgstr "Manca il suo title.tik."

msgid "The executable could not be started."
msgstr "Impossibile avviare l’eseguibile."

msgid "The Vulkan renderer did not start: {0}"
msgstr "Il renderer Vulkan non si è avviato: {0}"

msgid "Touchpad click + Options: the in-game menu (screens, picture, volume, controls, the library)"
msgstr "Clic sul touch pad + OPTIONS: il menu di gioco (schermi, immagine, volume, comandi, libreria)"

