msgstr "Spillbar"

msgctxt "status"
msgid "Issues"
msgstr "Problemer"

msgctxt "status"
msgid "Crashes"
msgstr "Krasjer"

msgctxt "status"
msgid "Won't start"
msgstr "Starter ikke"

msgid "the PS5 Vulkan driver did not start"
msgstr "PS5-ens Vulkan-driver startet ikke"

msgid "PS5CEMU-HAR cannot write to {0}. Is the HEN loaded?"
msgstr "PS5CEMU-HAR kan ikke skrive til {0}. Er HEN lastet inn?"

msgid "PS5CEMU-HAR cannot create the MLC folder {0}"
msgstr "PS5CEMU-HAR kan ikke opprette MLC-mappen {0}"

msgid "The game's base files were not found."
msgstr "Spillets basisfiler ble ikke funnet."

msgid "The game could not be mounted. Check that its files are still in the game files folder."
msgstr "Spillet kunne ikke monteres. Sjekk at filene fortsatt ligger i spillmappen."

msgid "The game could not be started."
msgstr "Spillet kunne ikke startes."

msgid "This is not a Wii U game PS5CEMU-HAR can start."
msgstr "Dette er ikke et Wii U-spill som PS5CEMU-HAR kan starte."

msgid "Its disc key is missing from /data/ps5cemu/keys.txt."
msgstr "Platenøkkelen mangler i /data/ps5cemu/keys.txt."

msgid "Its title.tik is missing."
msgstr "title.tik-filen mangler."

msgid "The executable could not be started."
msgstr "Den kjørbare filen kunne ikke startes."

msgid "The Vulkan renderer did not start: {0}"
msgstr "Vulkan-rendereren startet ikke: {0}"

msgid "Touchpad click + Options: the in-game menu (screens, picture, volume, controls, the library)"
msgstr "Klikk på styreflaten + OPTIONS: spillmenyen (skjermer, bilde, volum, kontroller, biblioteket)"

