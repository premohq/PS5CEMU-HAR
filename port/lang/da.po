msgid "Playable"
msgstr "Spilbar"

msgctxt "status"
msgid "Issues"
msgstr "Problemer"

msgctxt "status"
msgid "Crashes"
msgstr "Går ned"

msgctxt "status"
msgid "Won't start"
msgstr "Starter ikke"

msgid "the PS5 Vulkan driver did not start"
msgstr "PS5’ens Vulkan-driver startede ikke"

msgid "PS5CEMU-HAR cannot write to {0}. Is the HEN loaded?"
msgstr "PS5CEMU-HAR kan ikke skrive til {0}. Er HEN indlæst?"

msgid "PS5CEMU-HAR cannot create the MLC folder {0}"
msgstr "PS5CEMU-HAR kan ikke oprette MLC-mappen {0}"

msgid "The game's base files were not found."
msgstr "Spillets basisfiler blev ikke fundet."

msgid "The game could not be mounted. Check that its files are still in the game files folder."
msgstr "Spillet kunne ikke monteres. Tjek, at dets filer stadig er i spilmappen."

msgid "The game could not be started."
msgstr "Spillet kunne ikke startes."

msgid "This is not a Wii U game PS5CEMU-HAR can start."
msgstr "Det her er ikke et Wii U-spil, som PS5CEMU-HAR kan starte."

msgid "Its disc key is missing from /data/ps5cemu/keys.txt."
msgstr "Dets disknøgle mangler i /data/ps5cemu/keys.txt."

msgid "Its title.tik is missing."
msgstr "Dets title.tik mangler."

msgid "The executable could not be started."
msgstr "Den eksekverbare fil kunne ikke startes."

msgid "The Vulkan renderer did not start: {0}"
msgstr "Vulkan-rendereren startede ikke: {0}"

msgid "Touchpad click + Options: the in-game menu (screens, picture, volume, controls, the library)"
msgstr "Klik på touchpladen + OPTIONS: spilmenuen (skærme, billede, lydstyrke, styring, biblioteket)"

