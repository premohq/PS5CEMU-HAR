msgctxt "status"
msgid "Playable"
msgstr "Παίζεται"

msgctxt "status"
msgid "Issues"
msgstr "Προβλήματα"

msgctxt "status"
msgid "Crashes"
msgstr "Κολλάει"

msgctxt "status"
msgid "Won't start"
msgstr "Δεν ξεκινά"

msgid "the PS5 Vulkan driver did not start"
msgstr "το πρόγραμμα οδήγησης Vulkan του PS5 δεν ξεκίνησε"

msgid "PS5CEMU-HAR cannot write to {0}. Is the HEN loaded?"
msgstr "Το PS5CEMU-HAR δεν μπορεί να γράψει στο {0}. Έχει φορτωθεί το HEN;"

msgid "PS5CEMU-HAR cannot create the MLC folder {0}"
msgstr "Το PS5CEMU-HAR δεν μπορεί να δημιουργήσει τον φάκελο MLC {0}"

msgid "The game's base files were not found."
msgstr "Τα βασικά αρχεία του παιχνιδιού δεν βρέθηκαν."

msgid "The game could not be mounted. Check that its files are still in the game files folder."
msgstr "Το παιχνίδι δεν ήταν δυνατό να προσαρτηθεί. Ελέγξτε αν τα αρχεία του είναι ακόμα στον φάκελο παιχνιδιών."

msgid "The game could not be started."
msgstr "Το παιχνίδι δεν ήταν δυνατό να ξεκινήσει."

msgid "This is not a Wii U game PS5CEMU-HAR can start."
msgstr "Αυτό δεν είναι παιχνίδι Wii U που μπορεί να ξεκινήσει το PS5CEMU-HAR."

msgid "Its disc key is missing from /data/ps5cemu/keys.txt."
msgstr "Το κλειδί του δίσκου του λείπει από το /data/ps5cemu/keys.txt."

msgid "Its title.tik is missing."
msgstr "Λείπει το title.tik του."

msgid "The executable could not be started."
msgstr "Το εκτελέσιμο δεν ήταν δυνατό να ξεκινήσει."

msgid "The Vulkan renderer did not start: {0}"
msgstr "Η απόδοση Vulkan δεν ξεκίνησε: {0}"

msgid "Touchpad click + Options: the in-game menu (screens, picture, volume, controls, the library)"
msgstr "Κλικ στην επιφάνεια αφής + OPTIONS: το μενού του παιχνιδιού (οθόνες, εικόνα, ένταση, χειρισμός, βιβλιοθήκη)"

