msgid "Playable"
msgstr "Pelattava"

msgctxt "status"
msgid "Issues"
msgstr "Ongelmia"

msgctxt "status"
msgid "Crashes"
msgstr "Kaatuu"

msgctxt "status"
msgid "Won't start"
msgstr "Ei käynnisty"

msgid "the PS5 Vulkan driver did not start"
msgstr "PS5:n Vulkan-ajuri ei käynnistynyt"

msgid "PS5CEMU-HAR cannot write to {0}. Is the HEN loaded?"
msgstr "PS5CEMU-HAR ei voi kirjoittaa kohteeseen {0}. Onko HEN ladattu?"

msgid "PS5CEMU-HAR cannot create the MLC folder {0}"
msgstr "PS5CEMU-HAR ei voi luoda MLC-kansiota {0}"

msgid "The game's base files were not found."
msgstr "Pelin perustiedostoja ei löytynyt."

msgid "The game could not be mounted. Check that its files are still in the game files folder."
msgstr "Peliä ei voitu liittää. Tarkista, että sen tiedostot ovat yhä pelikansiossa."

msgid "The game could not be started."
msgstr "Peliä ei voitu käynnistää."

msgid "This is not a Wii U game PS5CEMU-HAR can start."
msgstr "Tämä ei ole Wii U -peli, jonka PS5CEMU-HAR voi käynnistää."

msgid "Its disc key is missing from /data/ps5cemu/keys.txt."
msgstr "Sen levyavain puuttuu tiedostosta /data/ps5cemu/keys.txt."

msgid "Its title.tik is missing."
msgstr "Sen title.tik puuttuu."

msgid "The executable could not be started."
msgstr "Suoritettavaa tiedostoa ei voitu käynnistää."

msgid "The Vulkan renderer did not start: {0}"
msgstr "Vulkan-renderöijä ei käynnistynyt: {0}"

msgid "Touchpad click + Options: the in-game menu (screens, picture, volume, controls, the library)"
msgstr "Kosketuslevyn painallus + OPTIONS: pelin sisäinen valikko (näytöt, kuva, äänenvoimakkuus, ohjaus, kirjasto)"

