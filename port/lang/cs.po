msgctxt "status"
msgid "Playable"
msgstr "Hratelná"

msgctxt "status"
msgid "Issues"
msgstr "Problémy"

msgctxt "status"
msgid "Crashes"
msgstr "Padá"

msgctxt "status"
msgid "Won't start"
msgstr "Nespustí se"

msgid "the PS5 Vulkan driver did not start"
msgstr "ovladač Vulkan na PS5 se nespustil"

msgid "PS5CEMU-HAR cannot write to {0}. Is the HEN loaded?"
msgstr "PS5CEMU-HAR nemůže zapisovat do {0}. Je HEN načtený?"

msgid "PS5CEMU-HAR cannot create the MLC folder {0}"
msgstr "PS5CEMU-HAR nemůže vytvořit složku MLC {0}"

msgid "The game's base files were not found."
msgstr "Základní soubory hry nebyly nalezeny."

msgid "The game could not be mounted. Check that its files are still in the game files folder."
msgstr "Hru se nepodařilo připojit. Zkontrolujte, zda jsou její soubory stále ve složce s hrami."

msgid "The game could not be started."
msgstr "Hru se nepodařilo spustit."

msgid "This is not a Wii U game PS5CEMU-HAR can start."
msgstr "Toto není hra pro Wii U, kterou PS5CEMU-HAR dokáže spustit."

msgid "Its disc key is missing from /data/ps5cemu/keys.txt."
msgstr "V /data/ps5cemu/keys.txt chybí klíč jejího disku."

msgid "Its title.tik is missing."
msgstr "Chybí její soubor title.tik."

msgid "The executable could not be started."
msgstr "Spustitelný soubor se nepodařilo spustit."

msgid "The Vulkan renderer did not start: {0}"
msgstr "Vykreslovač Vulkan se nespustil: {0}"

msgid "Touchpad click + Options: the in-game menu (screens, picture, volume, controls, the library)"
msgstr "Kliknutí na dotykovou plochu + OPTIONS: herní nabídka (obrazovky, obraz, hlasitost, ovládání, knihovna)"

